<Window x:Class="CDGlass.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CDGlass.Windows" Title="CD Glass" Width="1120" Height="764" MinWidth="780" MinHeight="554" WindowStartupLocation="CenterScreen" Background="#FBF2F5" Foreground="#3B2A31" AllowDrop="True" FontFamily="Segoe UI">
 <Grid x:Name="Stage" ClipToBounds="True">
  <Grid.Background><RadialGradientBrush Center="0.27,0.22" GradientOrigin="0.27,0.22" RadiusX="0.9" RadiusY="1.1"><GradientStop x:Name="GlowColor" Color="#F8C3D4" Offset="0"/><GradientStop x:Name="BaseColor" Color="#FBF2F5" Offset="1"/></RadialGradientBrush></Grid.Background>
  <Image x:Name="BackgroundCover" IsHitTestVisible="False" Stretch="UniformToFill" Margin="-30" Opacity="0"/>
  <Border x:Name="BackgroundVeil" IsHitTestVisible="False" Opacity="0"/>
  <Border x:Name="BackgroundVignette" IsHitTestVisible="False"/>
  <Border x:Name="BackgroundScrim" IsHitTestVisible="False"/>
  <Canvas x:Name="Particles" IsHitTestVisible="False"/>
  <Canvas x:Name="PlayerPage">
   <Grid x:Name="HeroHost"><local:HeroVisual x:Name="Hero"/></Grid>
   <StackPanel x:Name="SoloInfo"><TextBlock x:Name="SoloIndex" TextAlignment="Center" Opacity="0.6"/><TextBlock x:Name="SoloTitle" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,4"/><TextBlock x:Name="SoloArtist" TextAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.72"/></StackPanel>
   <Grid x:Name="DetailsPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button x:Name="ListButton" Content="L I S T" Click="ListButton_Click" HorizontalAlignment="Left" FontSize="10" Opacity="0.6" Padding="0" Margin="0,0,0,6" ToolTip="显示 / 隐藏曲目列表 · L"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"><StackPanel x:Name="TrackList"/></ScrollViewer>
   </Grid>
   <Canvas x:Name="TopBar">
    <Button x:Name="WallButton" Click="WallButton_Click" ToolTip="专辑墙 · Ctrl+B" Width="48" Height="48"><local:Glyph Kind="wall" Width="16" Height="16"/></Button>
    <Button x:Name="SettingsButton" Click="SettingsButton_Click" ToolTip="更多操作" Width="48" Height="48"><local:Glyph Kind="settings" Width="18" Height="18"/></Button>
   </Canvas>
   <Canvas x:Name="PlaybackFooter">
    <TextBlock x:Name="Elapsed" Text="0:00" FontSize="11" Opacity="0.6"/>
    <TextBlock x:Name="Remaining" Text="−0:00" FontSize="11" Opacity="0.6" TextAlignment="Right"/>
    <Slider x:Name="Progress" Minimum="0" Maximum="1000" ValueChanged="Progress_ValueChanged" PreviewMouseDown="Progress_PreviewMouseDown" PreviewMouseUp="Progress_PreviewMouseUp" Height="18"/>
    <StackPanel x:Name="OpenActions" Orientation="Horizontal"><Button Click="OpenFolder_Click" Padding="14,4"><StackPanel Orientation="Horizontal"><local:Glyph Kind="folder" Width="14" Height="14" Margin="0,0,8,0"/><TextBlock Text="打开文件夹…"/></StackPanel></Button><Button Click="Demo_Click" Padding="14,4"><StackPanel Orientation="Horizontal"><local:Glyph Kind="demo" Width="14" Height="14" Margin="0,0,8,0"/><TextBlock Text="试听示例"/></StackPanel></Button><Button Click="WallButton_Click" Padding="14,4"><StackPanel Orientation="Horizontal"><local:Glyph Kind="wall" Width="14" Height="14" Margin="0,0,8,0"/><TextBlock Text="专辑墙"/></StackPanel></Button></StackPanel>
    <Canvas x:Name="PlaybackActions"><Button x:Name="PreviousButton" Click="Previous_Click"><local:Glyph Kind="previous" Width="18" Height="18"/></Button><Button x:Name="PlayButton" Click="Play_Click"><local:Glyph x:Name="PlayGlyph" Kind="play" Width="27" Height="27"/></Button><Button x:Name="NextButton" Click="Next_Click"><local:Glyph Kind="next" Width="18" Height="18"/></Button></Canvas>
    <Canvas x:Name="VolumeActions" Opacity="0.45"><Button x:Name="MuteButton" Click="Mute_Click"><local:Glyph x:Name="VolumeGlyph" Kind="volume" Width="14" Height="14"/></Button><Slider x:Name="Volume" Minimum="0" Maximum="100" Value="75" ValueChanged="Volume_ValueChanged" Height="18"/></Canvas>
   </Canvas>
   <StackPanel Visibility="Collapsed"><TextBlock x:Name="AlbumTitle"/><TextBlock x:Name="AlbumArtist"/><TextBlock x:Name="DiscNumber"/><TextBlock x:Name="TrackCountLabel"/></StackPanel>
  </Canvas>
  <Grid x:Name="WallPage" Visibility="Collapsed" Opacity="0" Background="#FBF2F5"><Grid.RowDefinitions><RowDefinition Height="154"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Image Grid.RowSpan="2" IsHitTestVisible="False" Stretch="UniformToFill" Margin="-30" Source="{Binding Source,ElementName=BackgroundCover}" Opacity="{Binding Opacity,ElementName=BackgroundCover}"/>
   <Border Grid.RowSpan="2" IsHitTestVisible="False" Background="{Binding Background,ElementName=BackgroundVeil}" Opacity="{Binding Opacity,ElementName=BackgroundVeil}"/>
   <Border Grid.RowSpan="2" IsHitTestVisible="False" Background="{Binding Background,ElementName=BackgroundVignette}"/>
   <Border Grid.RowSpan="2" IsHitTestVisible="False" Background="{Binding Background,ElementName=BackgroundScrim}"/>
   <Canvas x:Name="WallHeader"><Button x:Name="WallBack" Click="WallBack_Click" ToolTip="返回"><local:Glyph Kind="wall" Width="16" Height="16"/></Button><TextBlock x:Name="WallHeading" Text="音乐收藏" FontSize="32" FontWeight="Light"/><TextBlock x:Name="WallTotal" FontSize="12" Opacity="0.6"/><Button x:Name="GroupButton" Click="Group_Click" FontSize="12" Opacity="0.72"/><Button x:Name="WallArchive" Content="归档到文件夹…" Click="Archive_Click" FontSize="12" Opacity="0.72"/><Button x:Name="WallScan" Content="＋  添加文件夹" Click="Scan_Click" FontSize="12" Opacity="0.72"/></Canvas>
   <ScrollViewer x:Name="WallScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden"><WrapPanel x:Name="WallItems" HorizontalAlignment="Center"/></ScrollViewer>
   <Canvas x:Name="BurstItems" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent" Margin="0,64,0,0"/>
   <TextBlock x:Name="WallHint" Visibility="Collapsed"/>
  </Grid>
  <Canvas x:Name="TransitionLayer" IsHitTestVisible="False"/>
  <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,72,0" CornerRadius="12" Padding="12,6" Background="#18293746"><TextBlock x:Name="ToastText" FontSize="11"/></Border>
 </Grid>
</Window>
